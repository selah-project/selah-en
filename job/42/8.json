{"book":"job","lang":"en2","model":"glm-5.3","timestamp":"2026-08-30T00:23:18.508762623Z","verse":8,"ref":"job 42:8","tier":"glm-5.2","chapter":42,"translation":"And now, take for yourselves seven bulls and seven rams, and go to my servant Job, and offer up a burnt offering for yourselves, and Job my servant will pray for you; for his face I will lift, so as not to do with you ⟨anything⟩ foolish; for you have not spoken what is right about me, as my servant Job ⟨has⟩.”","tokens":[{"surface":"ועתה","gloss":"and now"},{"surface":"קחו","gloss":"take"},{"surface":"לכם","gloss":"for yourselves"},{"surface":"שבעה","gloss":"seven"},{"surface":"פרים","gloss":"bulls"},{"surface":"ושבעה","gloss":"and seven"},{"surface":"אילים","gloss":"rams"},{"surface":"ולכו","gloss":"and go"},{"surface":"אל","gloss":"to"},{"surface":"עבדי","gloss":"my servant"},{"surface":"איוב","gloss":"Job"},{"surface":"והעליתם","gloss":"and offer up"},{"surface":"עולה","gloss":"a burnt offering"},{"surface":"בעדכם","gloss":"on your behalf"},{"surface":"ואיוב","gloss":"and Job"},{"surface":"עבדי","gloss":"my servant"},{"surface":"יתפלל","gloss":"will pray"},{"surface":"עליכם","gloss":"for you"},{"surface":"כי","gloss":"for"},{"surface":"אם","gloss":"only"},{"surface":"פניו","gloss":"his face"},{"surface":"אשא","gloss":"I will lift"},{"surface":"לבלתי","gloss":"so as not to"},{"surface":"עשות","gloss":"do"},{"surface":"עמכם","gloss":"with you"},{"surface":"נבלה","gloss":"anything foolish"},{"surface":"כי","gloss":"for"},{"surface":"לא","gloss":"not"},{"surface":"דברתם","gloss":"you have spoken"},{"surface":"אלי","gloss":"to me"},{"surface":"נכונה","gloss":"what is right"},{"surface":"כעבדי","gloss":"as my servant"},{"surface":"איוב","gloss":"Job"}]}