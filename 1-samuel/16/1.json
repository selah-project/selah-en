{"verse":1,"translation":"And YHWH said to Samuel, “How long will you mourn for Saul, when I have rejected him from reigning over Israel? Fill your horn with oil, and go — I will send you to Jesse the Bethlehemite, for I have seen among his sons a king for myself.”","tokens":[{"surface":"ויאמר","gloss":"And…said"},{"surface":"יהוה","gloss":"YHWH"},{"surface":"אל","gloss":"to"},{"surface":"שמואל","gloss":"Samuel"},{"surface":"עד","gloss":"until"},{"surface":"מתי","gloss":"how long","readings":["how long","when"],"held_by":{"how long":["v2","v3"],"when":["v1","en4"]},"disputed":true},{"surface":"אתה","gloss":"you"},{"surface":"מתאבל","gloss":"mourn"},{"surface":"אל","gloss":"for"},{"surface":"שאול","gloss":"Saul"},{"surface":"ואני","gloss":"and I"},{"surface":"מאסתיו","gloss":"have rejected him"},{"surface":"ממלך","gloss":"from reigning"},{"surface":"על","gloss":"over"},{"surface":"ישראל","gloss":"Israel"},{"surface":"מלא","gloss":"Fill"},{"surface":"קרנך","gloss":"your horn"},{"surface":"שמן","gloss":"with oil"},{"surface":"ולך","gloss":"and go"},{"surface":"אשלחך","gloss":"I will send you"},{"surface":"אל","gloss":"to"},{"surface":"ישי","gloss":"Jesse"},{"surface":"בית","gloss":"Beth"},{"surface":"הלחמי","gloss":"the Bethlehemite"},{"surface":"כי","gloss":"for"},{"surface":"ראיתי","gloss":"I have seen"},{"surface":"בבניו","gloss":"among his sons"},{"surface":"לי","gloss":"for myself"},{"surface":"מלך","gloss":"a king"}],"pass":"en5","judge":"glm-5.3"}