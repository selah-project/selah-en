{"tier":"glm-5.3-flash","verse":16,"ref":"judges 14:16","book":"judges","lang":"en4","chapter":14,"translation":"And Samson's wife wept upon him, and said, You only hate me, and have not loved me: the riddle you have riddled to the sons of my people, and to me you have not declared it. And he said to her, See, to my father and to my mother I have not declared it — and to you shall I declare it?","tokens":[{"surface":"ותבך","gloss":"and wept"},{"surface":"אשת","gloss":"the wife of"},{"surface":"שמשון","gloss":"Samson"},{"surface":"עליו","gloss":"upon him"},{"surface":"ותאמר","gloss":"and said"},{"surface":"רק","gloss":"only"},{"surface":"שנאתני","gloss":"you hate me"},{"surface":"ולא","gloss":"and not"},{"surface":"אהבתני","gloss":"you have loved me"},{"surface":"החידה","gloss":"the riddle"},{"surface":"חדת","gloss":"you have riddled"},{"surface":"לבני","gloss":"to the sons of"},{"surface":"עמי","gloss":"my people"},{"surface":"ולי","gloss":"and to me"},{"surface":"לא","gloss":"not"},{"surface":"הגדתה","gloss":"you have declared it"},{"surface":"ויאמר","gloss":"and said"},{"surface":"לה","gloss":"to her"},{"surface":"הנה","gloss":"see"},{"surface":"לאבי","gloss":"to my father"},{"surface":"ולאמי","gloss":"and to my mother"},{"surface":"לא","gloss":"not"},{"surface":"הגדתי","gloss":"I have declared it"},{"surface":"ולך","gloss":"and to you"},{"surface":"אגיד","gloss":"shall I declare it"}],"timestamp":"2026-09-20T10:06:55.682190598Z","model":"glm-5.3-flash"}