{"verse":52,"translation":"Witness is this heap, and the pillar is witness: if I do not cross over to you ⟨את⟩ this heap, and if you do not cross over to me ⟨את⟩ this heap and ⟨את⟩ this pillar, for harm.","tokens":[{"surface":"עד","gloss":"witness"},{"surface":"הגל","gloss":"the heap"},{"surface":"הזה","gloss":"this"},{"surface":"ועדה","gloss":"and witness"},{"surface":"המצבה","gloss":"the pillar","readings":["the pillar","the standing-stone"],"held_by":{"the pillar":["v1","v2","v3"],"the standing-stone":["en4"]}},{"surface":"אם","gloss":"if"},{"surface":"אני","gloss":"I"},{"surface":"לא","gloss":"not"},{"surface":"אעבר","gloss":"cross over","readings":["cross over","pass over"],"held_by":{"cross over":["v2","v3","en4"],"pass over":["v1","en4"]}},{"surface":"אליך","gloss":"to you"},{"surface":"את","gloss":"⟨את⟩"},{"surface":"הגל","gloss":"this heap"},{"surface":"הזה","gloss":"this"},{"surface":"ואם","gloss":"and if"},{"surface":"אתה","gloss":"you"},{"surface":"לא","gloss":"not"},{"surface":"תעבר","gloss":"cross over","readings":["cross over","pass over"],"held_by":{"cross over":["v2","v3"],"pass over":["v1","en4"]}},{"surface":"אלי","gloss":"to me"},{"surface":"את","gloss":"⟨את⟩"},{"surface":"הגל","gloss":"this heap"},{"surface":"הזה","gloss":"this"},{"surface":"ואת","gloss":"and ⟨את⟩"},{"surface":"המצבה","gloss":"the pillar"},{"surface":"הזאת","gloss":"this"},{"surface":"לרעה","gloss":"for harm"}],"pass":"en5","judge":"glm-5.3"}