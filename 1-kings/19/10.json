{"book":"1-kings","lang":"en","model":"glm-5.2","timestamp":"2026-07-23T11:33:13.071473632Z","verse":10,"ref":"1-kings 19:10","tier":"glm-5.2","chapter":19,"translation":"And he said, 'I have been utterly zealous for YHWH, Elohim of Hosts; for the children of Israel have forsaken your covenant — ⟨את⟩ your altars they have torn down, and ⟨את⟩ your prophets they have killed with the sword — and I alone am left, I by myself; and they seek ⟨את⟩ my life to take it away.'","tokens":[{"surface":"ויאמר","gloss":"And he said"},{"surface":"קנא","gloss":"I have been zealous"},{"surface":"קנאתי","gloss":"utterly zealous"},{"surface":"ליהוה","gloss":"for YHWH"},{"surface":"אלהי","gloss":"Elohim of"},{"surface":"צבאות","gloss":"Hosts"},{"surface":"כי","gloss":"for"},{"surface":"עזבו","gloss":"they have forsaken"},{"surface":"בריתך","gloss":"your covenant"},{"surface":"בני","gloss":"the children of"},{"surface":"ישראל","gloss":"Israel"},{"surface":"את","gloss":"⟨את⟩","marks":"your altars"},{"surface":"מזבחתיך","gloss":"your altars"},{"surface":"הרסו","gloss":"they have torn down"},{"surface":"ואת","gloss":"and ⟨את⟩","marks":"your prophets"},{"surface":"נביאיך","gloss":"your prophets"},{"surface":"הרגו","gloss":"they have killed"},{"surface":"בחרב","gloss":"with the sword"},{"surface":"ואותר","gloss":"and I am left"},{"surface":"אני","gloss":"I"},{"surface":"לבדי","gloss":"alone"},{"surface":"ויבקשו","gloss":"and they seek"},{"surface":"את","gloss":"⟨את⟩","marks":"my life"},{"surface":"נפשי","gloss":"my life"},{"surface":"לקחתה","gloss":"to take it"}]}