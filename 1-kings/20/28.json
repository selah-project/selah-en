{"book":"1-kings","lang":"en","model":"glm-5.2","timestamp":"2026-07-23T11:33:38.535205643Z","verse":28,"ref":"1-kings 20:28","tier":"glm-5.2","chapter":20,"translation":"And the man of Elohim drew near and spoke to the king of Israel, and said, \"Thus says YHWH: 'Because Aram has said, \"YHWH ⟨is⟩ a god of the mountains, and not a god of the valleys\" — therefore I will give ⟨את⟩ all this great multitude into your hand, and you shall know that I ⟨am⟩ YHWH.'\"","tokens":[{"surface":"ויגש","gloss":"And drew near"},{"surface":"איש","gloss":"the man"},{"surface":"האלהים","gloss":"of Elohim"},{"surface":"ויאמר","gloss":"and spoke"},{"surface":"אל","gloss":"to"},{"surface":"מלך","gloss":"the king"},{"surface":"ישראל","gloss":"of Israel"},{"surface":"ויאמר","gloss":"and said"},{"surface":"כה","gloss":"Thus"},{"surface":"אמר","gloss":"says"},{"surface":"יהוה","gloss":"YHWH"},{"surface":"יען","gloss":"Because"},{"surface":"אשר","gloss":"—"},{"surface":"אמרו","gloss":"has said"},{"surface":"ארם","gloss":"Aram"},{"surface":"אלהי","gloss":"a god of"},{"surface":"הרים","gloss":"the mountains"},{"surface":"יהוה","gloss":"YHWH"},{"surface":"ולא","gloss":"and not"},{"surface":"אלהי","gloss":"a god of"},{"surface":"עמקים","gloss":"the valleys"},{"surface":"הוא","gloss":"is He"},{"surface":"ונתתי","gloss":"therefore I will give"},{"surface":"את","gloss":"⟨את⟩","marks":"all this great multitude"},{"surface":"כל","gloss":"all"},{"surface":"ההמון","gloss":"this multitude"},{"surface":"הגדול","gloss":"great"},{"surface":"הזה","gloss":"this"},{"surface":"בידך","gloss":"into your hand"},{"surface":"וידעתם","gloss":"and you shall know"},{"surface":"כי","gloss":"that"},{"surface":"אני","gloss":"I"},{"surface":"יהוה","gloss":"YHWH"}]}