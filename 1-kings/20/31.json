{"book":"1-kings","lang":"en2","model":"glm-5.3","timestamp":"2026-08-29T22:19:08.332229846Z","verse":31,"ref":"1-kings 20:31","tier":"glm-5.2","chapter":20,"translation":"And his servants said to him, “Behold now, we have heard that the kings of the house of Israel, that they are kings of chesed; let us put, we pray, sackcloth on our loins and ropes on our heads, and go out to the king of Israel — perhaps he will keep alive ⟨את⟩ your life.”","tokens":[{"surface":"ויאמרו","gloss":"And they said"},{"surface":"אליו","gloss":"to him"},{"surface":"עבדיו","gloss":"his servants"},{"surface":"הנה","gloss":"Behold"},{"surface":"נא","gloss":"now"},{"surface":"שמענו","gloss":"we have heard"},{"surface":"כי","gloss":"that"},{"surface":"מלכי","gloss":"the kings of"},{"surface":"בית","gloss":"the house of"},{"surface":"ישראל","gloss":"Israel"},{"surface":"כי","gloss":"that"},{"surface":"מלכי","gloss":"kings of"},{"surface":"חסד","gloss":"chesed"},{"surface":"הם","gloss":"they are"},{"surface":"נשימה","gloss":"let us put"},{"surface":"נא","gloss":"we pray"},{"surface":"שקים","gloss":"sackcloth"},{"surface":"במתנינו","gloss":"on our loins"},{"surface":"וחבלים","gloss":"and ropes"},{"surface":"בראשנו","gloss":"on our heads"},{"surface":"ונצא","gloss":"and go out"},{"surface":"אל","gloss":"to"},{"surface":"מלך","gloss":"the king of"},{"surface":"ישראל","gloss":"Israel"},{"surface":"אולי","gloss":"perhaps"},{"surface":"יחיה","gloss":"he will keep alive"},{"surface":"את","gloss":"⟨את⟩","marks":"your life"},{"surface":"נפשך","gloss":"your life"}]}