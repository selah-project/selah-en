{"book":"leviticus","lang":"en2","model":"glm-5.3","timestamp":"2026-08-29T21:35:27.819248363Z","verse":11,"ref":"leviticus 21:11","tier":"glm-5.2","chapter":21,"translation":"And for any dead person he shall not come in; for his father and for his mother he shall not defile himself.","tokens":[{"surface":"ועל","gloss":"And upon"},{"surface":"כל","gloss":"all"},{"surface":"נפשת","gloss":"soul"},{"surface":"מת","gloss":"of dead"},{"surface":"לא","gloss":"not"},{"surface":"יבא","gloss":"come"},{"surface":"לאביו","gloss":"for his father"},{"surface":"ולאמו","gloss":"and for his mother"},{"surface":"לא","gloss":"not"},{"surface":"יטמא","gloss":"he shall defile himself"}]}