{"book":"leviticus","lang":"en2","model":"glm-5.3","timestamp":"2026-08-29T21:35:13.207940017Z","verse":18,"ref":"leviticus 21:18","tier":"glm-5.2","chapter":21,"translation":"For any man in whom there is a blemish shall not approach: a man blind or lame, or with a slit nose, or with a limb too long.","tokens":[{"surface":"כי","gloss":"For"},{"surface":"כל","gloss":"any"},{"surface":"איש","gloss":"man"},{"surface":"אשר","gloss":"who"},{"surface":"בו","gloss":"in him"},{"surface":"מום","gloss":"a blemish"},{"surface":"לא","gloss":"not"},{"surface":"יקרב","gloss":"shall approach"},{"surface":"איש","gloss":"a man"},{"surface":"עור","gloss":"blind"},{"surface":"או","gloss":"or"},{"surface":"פסח","gloss":"lame"},{"surface":"או","gloss":"or"},{"surface":"חרם","gloss":"with a slit nose"},{"surface":"או","gloss":"or"},{"surface":"שרוע","gloss":"with a limb too long"}]}