{"book":"leviticus","lang":"en2","model":"glm-5.3","timestamp":"2026-08-29T21:31:51.246202040Z","verse":11,"ref":"leviticus 5:11","tier":"glm-5.2","chapter":5,"translation":"But if his hand cannot reach to two turtledoves or to two young pigeons, then he shall bring ⟨את⟩ his offering for that which he sinned — a tenth of an ephah of fine flour for a sin offering; he shall put no oil on it, and he shall not put frankincense on it, for a sin offering it ⟨is⟩.","tokens":[{"surface":"ואם","gloss":"And if"},{"surface":"לא","gloss":"not"},{"surface":"תשיג","gloss":"⟨will⟩ not reach"},{"surface":"ידו","gloss":"his hand"},{"surface":"לשתי","gloss":"to two"},{"surface":"תרים","gloss":"turtledoves"},{"surface":"או","gloss":"or"},{"surface":"לשני","gloss":"to two"},{"surface":"בני","gloss":"young"},{"surface":"יונה","gloss":"pigeons"},{"surface":"והביא","gloss":"then he shall bring"},{"surface":"את","gloss":"⟨את⟩","marks":"his offering"},{"surface":"קרבנו","gloss":"his offering"},{"surface":"אשר","gloss":"which"},{"surface":"חטא","gloss":"he sinned"},{"surface":"עשירת","gloss":"a tenth"},{"surface":"האפה","gloss":"of the ephah"},{"surface":"סלת","gloss":"of fine flour"},{"surface":"לחטאת","gloss":"for a sin offering"},{"surface":"לא","gloss":"no"},{"surface":"ישים","gloss":"he shall put"},{"surface":"עליה","gloss":"upon it"},{"surface":"שמן","gloss":"oil"},{"surface":"ולא","gloss":"and not"},{"surface":"יתן","gloss":"shall he put"},{"surface":"עליה","gloss":"upon it"},{"surface":"לבנה","gloss":"frankincense"},{"surface":"כי","gloss":"for"},{"surface":"חטאת","gloss":"a sin offering"},{"surface":"היא","gloss":"it ⟨is⟩"}]}