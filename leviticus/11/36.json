{"book":"leviticus","lang":"en2","model":"glm-5.3","timestamp":"2026-08-29T21:32:22.822458661Z","verse":36,"ref":"leviticus 11:36","tier":"glm-5.2","chapter":11,"translation":"Only a spring or a cistern — a gathering of water — shall be clean; but one who touches their carcass becomes unclean.","tokens":[{"surface":"אך","gloss":"only"},{"surface":"מעין","gloss":"spring"},{"surface":"ובור","gloss":"or cistern"},{"surface":"מקוה","gloss":"gathering"},{"surface":"מים","gloss":"of water"},{"surface":"יהיה","gloss":"shall be"},{"surface":"טהור","gloss":"clean"},{"surface":"ונגע","gloss":"but one who touches"},{"surface":"בנבלתם","gloss":"their carcass"},{"surface":"יטמא","gloss":"becomes unclean"}]}