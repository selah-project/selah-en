{"book":"leviticus","lang":"en2","model":"glm-5.3","timestamp":"2026-08-29T21:34:14.370788805Z","verse":14,"ref":"leviticus 18:14","tier":"glm-5.2","chapter":18,"translation":"The nakedness of your father’s brother you shall not uncover; to his wife you shall not draw near — she is your aunt.","tokens":[{"surface":"ערות","gloss":"the nakedness"},{"surface":"אחי","gloss":"brother"},{"surface":"אביך","gloss":"of your father"},{"surface":"לא","gloss":"not"},{"surface":"תגלה","gloss":"you shall uncover"},{"surface":"אל","gloss":"to"},{"surface":"אשתו","gloss":"his wife"},{"surface":"לא","gloss":"not"},{"surface":"תקרב","gloss":"you shall draw near"},{"surface":"דדתך","gloss":"your aunt"},{"surface":"הוא","gloss":"she is"}]}